# ====== AI PROVIDER ======
# "gemini" yoki "openai"
AI_PROVIDER=gemini

# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ====== DATABASE ======
DATABASE_URL=sqlite:///./eduprep.db

# ====== TELEGRAM (ixtiyoriy) ======
# @BotFather orqali bot yarating va tokenni shu yerga qo'ying
TELEGRAM_BOT_TOKEN=

# Vaqt zonasi (eslatmalar shu bo'yicha yuboriladi)
TIMEZONE=Asia/Tashkent

# Frontend manzili (CORS uchun)
FRONTEND_ORIGIN=http://localhost:5173
